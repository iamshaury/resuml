{
  "manifest_version": 3,
  "name": "DraftFree",
  "version": "1.0",
  "description": "Autonomously hunts for SWE jobs in the background.",
  "permissions": [
    "alarms",
    "offscreen",
    "storage"
  ],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://*.indeed.com/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Show Latest Jobs"
  }
}